{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./cookie.schema.json",
  "title": "Recipe Graph",
  "type": "object",
  "required": ["ingredients", "steps"],
  "additionalProperties": false,
  "properties": {
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "number"
          },
          "units": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}